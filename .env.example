# Copy to your hosting provider's environment settings (never commit real values)
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=planner.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://planner.example.com
# PostgreSQL recommended for multiple users; omit to use SQLite in FTTH_DATA_DIR
DATABASE_URL=postgres://user:password@db-host:5432/ftth
# Persistent folder for SQLite (if used) and survey photos
FTTH_DATA_DIR=/data
# Optional: first admin account created on start-up
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me

# Photo AI (optional). A survey photo is sent to the provider only when a planner presses "Analyse".
# Roboflow workflow, e.g. a Qwen-VL workflow:
#   PHOTO_AI_PROVIDER=roboflow
#   PHOTO_AI_URL=https://serverless.roboflow.com/<workspace>/workflows/<workflow>
#   PHOTO_AI_MODEL=<model_version the workflow expects, if any>
# Groq (OpenAI-compatible chat completions with a vision model):
#   PHOTO_AI_PROVIDER=groq
#   PHOTO_AI_MODEL=<a Groq vision model id, e.g. qwen/qwen3.8-27b>
# Keep the key secret: never commit it.
PHOTO_AI_PROVIDER=
PHOTO_AI_URL=
PHOTO_AI_KEY=
PHOTO_AI_MODEL=

# AI assistant chat (the AI button in the planner): a Groq API key and chat model.
# The project's summary (counts, lengths, BOQ, QA issues, Photo AI findings) is sent with each question.
AI_CHAT_KEY=
AI_CHAT_MODEL=openai/gpt-oss-120b
